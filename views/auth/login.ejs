<%- include('../partials/header') %>

<div style="max-width: 460px; margin: 40px auto;">
  <div class="panel">
    <div class="panel-header">
      <h1 class="panel-title" style="font-size: 18px;">Sign In to Library Account</h1>
    </div>

    <form action="/auth/login" method="POST" novalidate>
      <div class="form-group">
        <label for="email" class="form-label required">Email Address or Member ID</label>
        <input 
          type="text" 
          id="email" 
          name="email" 
          class="form-control" 
          placeholder="e.g. member@library.org or MEM-2026-0101" 
          required 
          autocomplete="username"
          autofocus
        >
        <span class="form-hint">Staff members may sign in with their official staff email.</span>
      </div>

      <div class="form-group">
        <label for="password" class="form-label required">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-control" 
          required 
          autocomplete="current-password"
        >
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="btn btn-primary btn-block">Sign In</button>
      </div>
    </form>

    <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--color-border); font-size: 13px; text-align: center;">
      <span>New member? <a href="/auth/register">Register for an institutional library card</a></span>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
