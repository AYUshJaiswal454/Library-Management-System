<%- include('../partials/header') %>

<div class="breadcrumb-bar">
  <a href="/member/dashboard">Dashboard</a> / <span>Borrowing History</span>
</div>

<div class="page-header">
  <div>
    <h1 class="page-title">Borrowing History & Past Returns</h1>
    <div class="page-subtitle">Complete chronological record of all your previous library circulation transactions</div>
  </div>
</div>

<div class="panel">
  <% if (loans.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">📜</div>
      <div class="empty-title">No Past Transactions</div>
      <div class="empty-desc">You have not completed any book return cycles yet.</div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Barcode</th>
            <th>Title & Author</th>
            <th>Issued On</th>
            <th>Scheduled Due</th>
            <th>Returned On</th>
            <th>Fine Incurred</th>
          </tr>
        </thead>
        <tbody>
          <% loans.forEach(function(loan) { %>
            <tr>
              <td><span class="mono"><%= loan.bookCopy ? loan.bookCopy.barcode : '—' %></span></td>
              <td>
                <strong><a href="/catalogue/<%= loan.book ? loan.book._id : '#' %>"><%= loan.book ? loan.book.title : 'Bibliographic Record' %></a></strong>
                <div style="font-size: 12px; color: var(--color-text-secondary);"><%= loan.book ? loan.book.author : '' %></div>
              </td>
              <td><%= formatDate(loan.issuedAt) %></td>
              <td><%= formatDate(loan.dueDate) %></td>
              <td><strong><%= formatDate(loan.returnedAt) %></strong></td>
              <td>
                <% if (loan.fineCalculated > 0) { %>
                  <span style="color: #b91c1c; font-weight: 600;"><%= formatCurrency(loan.fineCalculated) %></span>
                <% } else { %>
                  <span style="color: #15803d;">₹0 (Returned on time)</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
