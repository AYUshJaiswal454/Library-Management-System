<%- include('../../partials/header') %>

<div class="breadcrumb-bar">
  <a href="/librarian/desk">Circulation</a> / <span>Policy Settings</span>
</div>

<div class="page-header">
  <div>
    <h1 class="page-title">Library Circulation Policy Configuration</h1>
    <div class="page-subtitle">Configure lending periods, quotas, fine calculations, and hold targeting rules (Zero Magic Numbers)</div>
  </div>
</div>

<div style="max-width: 820px;">
  <div class="panel">
    <form action="/librarian/settings" method="POST">
      <h2 style="font-size: 15px; text-transform: uppercase; color: var(--color-gov-navy); margin-bottom: 16px; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
        1. Institutional Identity & Contact
      </h2>

      <div class="grid-2">
        <div class="form-group">
          <label for="libraryName" class="form-label required">Institution / Library Name</label>
          <input type="text" id="libraryName" name="libraryName" class="form-control" value="<%= settings.libraryName %>" required>
        </div>

        <div class="form-group">
          <label for="libraryCode" class="form-label required">Library Code</label>
          <input type="text" id="libraryCode" name="libraryCode" class="form-control mono" value="<%= settings.libraryCode %>" required>
        </div>
      </div>

      <div class="grid-3">
        <div class="form-group">
          <label for="contactEmail" class="form-label">Official Email</label>
          <input type="email" id="contactEmail" name="contactEmail" class="form-control" value="<%= settings.contactEmail %>">
        </div>

        <div class="form-group">
          <label for="contactPhone" class="form-label">Helpline Phone</label>
          <input type="text" id="contactPhone" name="contactPhone" class="form-control" value="<%= settings.contactPhone %>">
        </div>

        <div class="form-group">
          <label for="currencySymbol" class="form-label">Currency Symbol</label>
          <input type="text" id="currencySymbol" name="currencySymbol" class="form-control" value="<%= settings.currencySymbol %>">
        </div>
      </div>

      <div class="form-group">
        <label for="address" class="form-label">Physical Campus Address</label>
        <input type="text" id="address" name="address" class="form-control" value="<%= settings.address %>">
      </div>

      <h2 style="font-size: 15px; text-transform: uppercase; color: var(--color-gov-navy); margin: 24px 0 16px 0; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
        2. Circulation, Lending & Loan Quotas
      </h2>

      <div class="grid-2">
        <div class="form-group">
          <label for="loanPeriodDays" class="form-label required">Standard Lending Period (Days)</label>
          <input type="number" id="loanPeriodDays" name="loanPeriodDays" class="form-control" value="<%= settings.loanPeriodDays %>" min="1" max="90" required>
          <span class="form-hint">Number of days between checkout and due date.</span>
        </div>

        <div class="form-group">
          <label for="maxLoanLimit" class="form-label required">Maximum Active Loan Quota (Titles)</label>
          <input type="number" id="maxLoanLimit" name="maxLoanLimit" class="form-control" value="<%= settings.maxLoanLimit %>" min="1" max="20" required>
          <span class="form-hint">Maximum number of concurrent books allowed per member.</span>
        </div>
      </div>

      <h2 style="font-size: 15px; text-transform: uppercase; color: var(--color-gov-navy); margin: 24px 0 16px 0; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
        3. Overdue Fines & Eligibility Blocking
      </h2>

      <div class="grid-3">
        <div class="form-group">
          <label for="finePerDay" class="form-label required">Daily Overdue Fine Rate (₹)</label>
          <input type="number" id="finePerDay" name="finePerDay" class="form-control" value="<%= settings.finePerDay %>" min="0" step="0.5" required>
          <span class="form-hint">Fine charged per day late after grace period.</span>
        </div>

        <div class="form-group">
          <label for="gracePeriodDays" class="form-label required">Grace Period (Days)</label>
          <input type="number" id="gracePeriodDays" name="gracePeriodDays" class="form-control" value="<%= settings.gracePeriodDays %>" min="0" max="30" required>
          <span class="form-hint">Days past due date before fines begin accruing.</span>
        </div>

        <div class="form-group">
          <label for="maxFineAmount" class="form-label required">Maximum Fine Cap (₹)</label>
          <input type="number" id="maxFineAmount" name="maxFineAmount" class="form-control" value="<%= settings.maxFineAmount %>" min="0" required>
          <span class="form-hint">Maximum fine penalty per individual loan.</span>
        </div>
      </div>

      <div class="form-group">
        <label for="blockingFineThreshold" class="form-label required">Circulation Blocking Fine Balance (₹)</label>
        <input type="number" id="blockingFineThreshold" name="blockingFineThreshold" class="form-control" value="<%= settings.blockingFineThreshold %>" min="0" required>
        <span class="form-hint">Outstanding fine total that blocks new checkout operations for a member.</span>
      </div>

      <h2 style="font-size: 15px; text-transform: uppercase; color: var(--color-gov-navy); margin: 24px 0 16px 0; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
        4. Hold Queue & Pickup Windows
      </h2>

      <div class="grid-2">
        <div class="form-group">
          <label for="maxHoldLimit" class="form-label required">Max Active Holds Allowed</label>
          <input type="number" id="maxHoldLimit" name="maxHoldLimit" class="form-control" value="<%= settings.maxHoldLimit %>" min="1" max="10" required>
          <span class="form-hint">Maximum concurrent hold requests allowed per member.</span>
        </div>

        <div class="form-group">
          <label for="holdPickupWindowDays" class="form-label required">Hold Pickup Window (Days)</label>
          <input type="number" id="holdPickupWindowDays" name="holdPickupWindowDays" class="form-control" value="<%= settings.holdPickupWindowDays %>" min="1" max="30" required>
          <span class="form-hint">Days a targeted copy remains locked for patron pickup before auto-expiration.</span>
        </div>
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="btn btn-primary">Save Circulation Policies</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
